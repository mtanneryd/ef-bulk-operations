<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net11.0</TargetFrameworks>
		<EfCorePackageVersion Condition="'$(TargetFramework)' == 'net10.0'">10.0.10</EfCorePackageVersion>
		<EfCorePackageVersion Condition="'$(TargetFramework)' == 'net11.0'">11.0.0</EfCorePackageVersion>
		<Version>4.1.0</Version>
		<Authors>Måns Tånneryd</Authors>
		<Company>Tånneryd IT</Company>
		<Description>Provides bulk operations for EF Core</Description>
		<Product>BulkOperations for EFCore</Product>
		<Copyright>Copyright ©  2017-2026 Tånneryd IT AB</Copyright>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<PackageLicenseFile>LICENSE-2.0.txt</PackageLicenseFile>
		<PackageId>Tanneryd.BulkOperations.EFCore</PackageId>
		<PackageProjectUrl>https://www.nuget.org/packages/Tanneryd.BulkOperations.EFCore</PackageProjectUrl>
		<PackageReleaseNotes>Added a net11.0 target using EF Core 11.0.0. The net10.0 target remains on EF Core 10.0.10.</PackageReleaseNotes>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<EmbedAllSources>True</EmbedAllSources>
		<LangVersion>Latest</LangVersion>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="..\..\Tanneryd.BulkOperations.Common\Sql\*.cs" Link="Common\Sql\%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Tanneryd.BulkOperations.EFCore.Tests" />
	</ItemGroup>

	<ItemGroup> 
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="$(EfCorePackageVersion)" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Abstractions" Version="$(EfCorePackageVersion)" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(EfCorePackageVersion)" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="$(EfCorePackageVersion)">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<None Include="LICENSE-2.0.txt">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
		<None Include="..\..\README.md">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
	</ItemGroup>

</Project>