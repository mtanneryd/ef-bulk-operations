<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net48</TargetFrameworks>
		<Version>3.0.1</Version>
		<Authors>Måns Tånneryd</Authors>
		<Company>Tånneryd IT AB</Company>
		<Description>Provides bulk operations for EF6</Description>
		<Product>Tanneryd.BulkOperations.EF6</Product>
		<Copyright>Copyright ©  2017-2026 Tånneryd IT AB</Copyright>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<PackageLicenseFile>LICENSE-2.0.txt</PackageLicenseFile>
		<PackageId>Tanneryd.BulkOperations.EF6</PackageId>
		<PackageProjectUrl>https://www.nuget.org/packages/Tanneryd.BulkOperations.EF6</PackageProjectUrl>
		<PackageReleaseNotes>Updated NuGet package dependencies. Added VS Code build and test tasks. Minor code cleanup.</PackageReleaseNotes>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<EmbedAllSources>True</EmbedAllSources>
		<LangVersion>Latest</LangVersion>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="..\..\Tanneryd.BulkOperations.Common\Sql\*.cs" Link="Common\Sql\%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<None Include="LICENSE-2.0.txt">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
		<None Include="..\..\README.md">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="EntityFramework" Version="6.5.2" />
		<PackageReference Include="Microsoft.EntityFramework.SqlServer" Version="6.5.2" />
		<PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
		<PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
	</ItemGroup>

</Project>